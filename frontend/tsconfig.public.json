{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "outDir": "./node_modules/.cache/typescript/public",
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.cache/typescript/public.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src/entry.public.tsx", "src/ui/public/**/*.ts", "src/ui/public/**/*.tsx"],
  "exclude": ["dist", "src/entry.local.tsx", "src/ui/local"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
