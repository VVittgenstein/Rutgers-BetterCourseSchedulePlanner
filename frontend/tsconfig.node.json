{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "lib": ["ES2023"],
    "outDir": "./node_modules/.cache/typescript/build-config",
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.cache/typescript/build-config.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "build/**/*.ts",
    "vite.config.ts",
    "vite.local.config.ts",
    "vite.public.config.ts"
  ],
  "exclude": ["dist", "src", "ui"]
}
