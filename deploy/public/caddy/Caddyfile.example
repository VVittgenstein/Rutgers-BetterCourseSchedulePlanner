# Copy this site block into an operator-managed Caddy configuration only after
# replacing the invalid hostname. The package never installs or reloads Caddy.
planner.invalid {
	@metrics path /metrics /metrics/*
	respond @metrics 404

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@dynamic not path /assets/*
	header @dynamic Cache-Control "no-store"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy 127.0.0.1:8080 {
		# H2: Caddy >= 2.7 closes every proxied WebSocket the moment its
		# config reloads. Established streams -- live section monitoring --
		# get this long to keep flowing under the old config instead;
		# reload risk and scheduling advice are in docs/operator-runbook.md.
		stream_close_delay 4h
	}
}
