{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rbcsp.invalid/schema/bcsp-public-env-v1.json",
  "title": "RBCSP public service environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["BCSP_PUBLIC_ORIGIN"],
  "properties": {
    "BCSP_PUBLIC_ORIGIN": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^@/?#\\s]+$",
      "description": "External HTTPS origin without credentials, a path, query, or fragment."
    }
  },
  "secretVariables": []
}
