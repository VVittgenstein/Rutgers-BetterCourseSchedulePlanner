# The external browser-visible origin. HTTPS is required; do not add a path.
BCSP_PUBLIC_ORIGIN=https://planner.invalid
# Optional: per-client concurrent WebSocket cap (default 64, range 1..1024).
# Raise it only for campus NAT or a shared IPv6 /64 that legitimately fans
# many people out of one client key. Every other capacity number is fixed.
# BCSP_PUBLIC_WS_PER_CLIENT_LIMIT=64
